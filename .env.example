# Data archive (raw downloads live outside the repo; data/archive is a symlink to it)
FIN_DATA_ROOT=~/financial_archive

# API keys — never commit the real .env
FRED_API_KEY=YOUR_FRED_KEY
# Optional: free key from https://data.bls.gov/registrationEngine/ (20 years/request, 500 requests/day)
BLS_API_KEY=
# SEC requires a contact in the User-Agent: "Name email@example.com"
SEC_USER_AGENT="Your Name your@email.com"

# Neo4j
# Local Docker (make graph-up). For Aura use neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_random_password  # e.g. python -c "import secrets;print(secrets.token_urlsafe(24))"
# Docker memory (optional)
NEO4J_HEAP=2G
NEO4J_PAGECACHE=2G
NEO4J_DATABASE=neo4j

# Embeddings
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384
