<!-- D1 (docs/factors/D1_tendencia_diaria_spec.md §6): decisión diaria tras el cierre de EE. UU., lun-vie 22:30 Madrid.
     Desde el 20-nov-2026 D1 es SOLO PAPEL (decisión del usuario): decide y registra en research/paper/decisiones_d1.jsonl
     (exige research/paper/D1_ACTIVO), SIN espejo ni órdenes; su cuenta …X9F9 pasó a A1. Reinstalar esta versión:
     launchctl unload ~/Library/LaunchAgents/com.financialkb.d1.plist && cp scripts/launchd/com.financialkb.d1.plist
     ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.financialkb.d1.plist (lo hace el usuario). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.financialkb.d1</string>
  <key>WorkingDirectory</key><string>/Users/victorhdez12/Proyectos/financial_kb</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-lc</string>
    <string>.venv/bin/python -m scripts.paper_decision_d1 --auto --registrar</string>
